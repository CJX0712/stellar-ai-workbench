{
  "identifier": "default",
  "description": "桌面壳默认权限：允许拉起本地后端进程与打开文件，供 Python sidecar 使用。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-close",
    "shell:allow-execute",
    "shell:allow-kill",
    "shell:allow-open"
  ]
}
