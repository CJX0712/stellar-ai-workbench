{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stellar AI Workbench",
  "version": "0.1.0",
  "identifier": "com.chenxing.stellar-ai-workbench",
  "build": {
    "beforeDevCommand": "cd ../frontend && npm run dev",
    "beforeBuildCommand": "cd ../frontend && npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Stellar AI Workbench",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "copyright": "Copyright (c) 2026 晨星",
    "category": "DeveloperTool",
    "shortDescription": "模块化桌面 AI 工作台",
    "longDescription": "整合开源成果的模块化 AI 工作台：统一模型网关、可插拔 RAG、智能体编排、记忆与知识库，干净环境一键复现。",
    "externalBin": [],
    "resources": [],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  },
  "plugins": {}
}
